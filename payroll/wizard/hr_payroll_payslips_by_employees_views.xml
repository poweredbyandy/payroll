<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_hr_payslip_by_employees" model="ir.ui.view">
        <field name="name">payroll_payslip_employees</field>
        <field name="model">hr.payslip.employees</field>
        <field name="arch" type="xml">
            <form string="Payslips by Employees">
                <header>
                    <button
                        icon="fa-cogs"
                        string="Generate"
                        name="compute_sheet"
                        type="object"
                        class="oe_highlight"
                        invisible="not employee_ids"
                    />
                    <button
                        icon="fa-cogs"
                        string="Generate"
                        name="compute_sheet"
                        type="object"
                        class="oe_highlight disabled"
                        invisible="employee_ids"
                    />
                </header>
                <div class="alert alert-info" role="alert" invisible="employee_ids">
                    No employees with an open contract were found for this batch
                    period (and structure, if set). Add or adjust contracts, then
                    reopen this wizard.
                </div>
                <group>
                    <span colspan="4" nolabel="1">
                        Employees with an open contract overlapping the batch dates
                        are selected automatically. Uncheck those you want to skip,
                        then click Generate.
                    </span>
                </group>
                <group colspan="4">
                    <separator string="Employees" colspan="4" />
                    <newline />
                    <field name="employee_ids" nolabel="1" colspan="4" />
                </group>
                <separator colspan="4" />
                <footer>
                    <button
                        icon="fa-cogs"
                        string="Generate"
                        name="compute_sheet"
                        type="object"
                        class="oe_highlight"
                        invisible="not employee_ids"
                    />
                    <button
                        icon="fa-cogs"
                        string="Generate"
                        name="compute_sheet"
                        type="object"
                        class="oe_highlight disabled"
                        invisible="employee_ids"
                    />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_hr_payslip_by_employees" model="ir.actions.act_window">
        <field name="name">Generate Payslips</field>
        <field name="res_model">hr.payslip.employees</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_hr_payslip_by_employees" />
        <field name="target">new</field>
    </record>
</odoo>
