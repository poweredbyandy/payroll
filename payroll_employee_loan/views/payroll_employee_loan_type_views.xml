<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="payroll_employee_loan_type_view_tree" model="ir.ui.view">
        <field name="name">payroll.employee.loan.type.list</field>
        <field name="model">payroll.employee.loan.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="loan_term" />
                <field name="interest_rate" />
                <field name="interest_type" />
            </list>
        </field>
    </record>
    <record id="payroll_employee_loan_type_view_form" model="ir.ui.view">
        <field name="name">payroll.employee.loan.type.form</field>
        <field name="model">payroll.employee.loan.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="General">
                            <field name="name" />
                            <field name="loan_term" />
                            <field name="interest_rate" />
                            <field name="interest_type" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="active" />
                        </group>
                        <group string="Disbursement Accounting">
                            <field name="journal_id" />
                            <field name="disbursement_account_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="payroll_employee_loan_type_action" model="ir.actions.act_window">
        <field name="name">Loan Types</field>
        <field name="res_model">payroll.employee.loan.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
