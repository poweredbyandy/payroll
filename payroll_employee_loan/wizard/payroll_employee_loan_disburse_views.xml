<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="payroll_employee_loan_disburse_view_form" model="ir.ui.view">
        <field name="name">payroll.employee.loan.disburse.form</field>
        <field name="model">payroll.employee.loan.disburse</field>
        <field name="arch" type="xml">
            <form string="Disburse Loan">
                <group>
                    <group>
                        <field name="loan_id" readonly="1" />
                        <field name="amount" />
                        <field name="currency_id" />
                        <field
                            name="amount_company"
                            invisible="not display_amount_company"
                        />
                        <field name="company_currency_id" invisible="1" />
                        <field name="display_amount_company" invisible="1" />
                        <field name="company_id" invisible="1" />
                        <field name="payment_date" />
                    </group>
                    <group>
                        <field name="journal_id" />
                        <field name="available_payment_method_line_ids" invisible="1" />
                        <field name="payment_method_line_id" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_confirm_disburse"
                        string="Disburse"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payroll_employee_loan_disburse" model="ir.actions.act_window">
        <field name="name">Disburse Loan</field>
        <field name="res_model">payroll.employee.loan.disburse</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
