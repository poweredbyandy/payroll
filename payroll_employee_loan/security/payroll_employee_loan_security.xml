<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_payroll_loan" model="ir.module.category">
        <field name="name">Employee Loans</field>
        <field name="parent_id" ref="base.module_category_human_resources" />
    </record>
    <record id="group_payroll_loan_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_payroll_loan" />
        <field name="implied_ids" eval="[(4, ref('payroll.group_payroll_user'))]" />
    </record>
    <record id="group_payroll_loan_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_payroll_loan" />
        <field
            name="implied_ids"
            eval="[(4, ref('group_payroll_loan_user')), (4, ref('payroll.group_payroll_manager'))]"
        />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
    <record id="payroll_employee_loan_rule_employee" model="ir.rule">
        <field name="name">Employee: own loans</field>
        <field name="model_id" ref="model_payroll_employee_loan" />
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="payroll_employee_loan_rule_manager" model="ir.rule">
        <field name="name">Loan manager: all</field>
        <field name="model_id" ref="model_payroll_employee_loan" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_payroll_loan_manager'))]" />
    </record>
</odoo>
